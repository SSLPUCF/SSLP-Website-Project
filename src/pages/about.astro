---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Names and roles are edited in src/content/about/team.md, not here.
const team = await getEntry('about', 'team');
if (!team) throw new Error('Missing file: src/content/about/team.md');
---

<BaseLayout title="About us">
  <h1>About us</h1>

  {
    team.data.groups.map((group, index) => (
      <section class="split" aria-labelledby={`group-${index}`}>
        <h2 id={`group-${index}`}>{group.title}</h2>
        <div>
          {group.members.length > 0 ? (
            <ul>
              {group.members.map((member) => (
                <li>
                  <p class="name">{member.name}</p>
                  <p class="role">{member.role}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="role">No one is listed yet.</p>
          )}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-7);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    max-width: none;
    padding-block: var(--space-3);
  }

  li:first-child {
    padding-top: 0;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  p {
    margin: 0;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .role {
    color: var(--text-muted);
  }

  @media (min-width: 40rem) {
    li {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: baseline;
    }
  }
</style>
