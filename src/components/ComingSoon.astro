---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  /** One sentence on what the page will hold. */
  summary: string;
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title}>
  <h1>{title}</h1>
  <p>Coming soon. {summary}</p>
  <p><a href={url('/')}>Go to the home page</a></p>
</BaseLayout>
