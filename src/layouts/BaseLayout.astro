---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `${site.fullName} at the ${site.school}.`,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.shortName}` : `${site.shortName}: ${site.fullName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- TODO: replace with a favicon made from the club logo -->
    <link rel="icon" href="data:," />

    <!-- Runs before the page draws, so a saved mode doesn't flash the wrong colors. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-dm-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
